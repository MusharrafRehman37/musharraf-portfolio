PORT=5000
# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/portfolio for local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Frontend URL allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173
# Secret key to read saved messages (GET /api/contact with header x-admin-key)
ADMIN_KEY=change-this-to-a-long-random-string
